{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "win-msvc",
      "displayName": "Windows / MSVC / Ninja / Debug",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-msvc-release",
      "displayName": "Windows / MSVC / Ninja / Release",
      "inherits": "win-msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "mac-arm64",
      "displayName": "macOS / AppleClang / Ninja / Debug",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "ci-lavapipe",
      "displayName": "Linux / lavapipe 软件渲染（CI 判分基准）",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "win-msvc",    "configurePreset": "win-msvc" },
    { "name": "mac-arm64",   "configurePreset": "mac-arm64" },
    { "name": "ci-lavapipe", "configurePreset": "ci-lavapipe" }
  ],
  "testPresets": [
    {
      "name": "win-msvc",
      "configurePreset": "win-msvc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "mac-arm64",
      "configurePreset": "mac-arm64",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-lavapipe",
      "configurePreset": "ci-lavapipe",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
