#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer InputPixels { vec4 inputPixels[]; };
layout(std430, set = 0, binding = 1) writeonly buffer FilteredPixels { vec4 filteredPixels[]; };

layout(push_constant) uniform Push { uint width; uint height; } pc;

uint indexOf(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
    return uint(p.y) * pc.width + uint(p.x);
}

void main() {
    uvec2 pos = gl_GlobalInvocationID.xy;
    if (pos.x >= pc.width || pos.y >= pc.height) return;

    const float w[3] = float[3](1.0, 2.0, 1.0);
    vec3 blurred = vec3(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            blurred += inputPixels[indexOf(ivec2(pos) + ivec2(x, y))].rgb *
                       (w[x + 1] * w[y + 1]);
        }
    }
    blurred /= 16.0;
    vec3 mapped = blurred / (vec3(1.0) + blurred);
    filteredPixels[pos.y * pc.width + pos.x] = vec4(mapped, 1.0);
}
