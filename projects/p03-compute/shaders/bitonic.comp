#version 450

// t04 —— bitonic compare-and-swap 的一个网络阶段。
// host 用 (k,j) 双层循环发完整排序网络；每个 invocation 只负责一对元素。
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer DataBuf { uint data[]; };

layout(push_constant) uniform Push {
    uint n;
    uint k;
    uint j;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    uint partner = i ^ pc.j;

    // 每对只让较小索引的线程写，避免两个 invocation 同时交换同一对元素。
    if (partner <= i || partner >= pc.n) return;
    bool ascending = (i & pc.k) == 0u;
    uint a = data[i];
    uint b = data[partner];
    if ((ascending && a > b) || (!ascending && a < b)) {
        data[i]       = b;
        data[partner] = a;
    }
}
