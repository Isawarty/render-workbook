#version 450

layout(local_size_x = 256) in;
layout(std430, set=0, binding=0) readonly buffer InputBuffer { float inputData[]; };
layout(std430, set=0, binding=1) writeonly buffer OutputBuffer { float outputData[]; };
layout(push_constant) uniform Push { uint n; float factor; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    outputData[i] = inputData[i] * pc.factor;
}
