#version 450

layout(local_size_x = 256) in;
layout(std430, set=0, binding=0) buffer Positions { vec4 positions[]; };
layout(push_constant) uniform Push { uint n; float dx; float dy; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    positions[i].xy += vec2(pc.dx, pc.dy);
}
