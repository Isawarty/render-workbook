#version 450
layout(local_size_x = 32) in;
layout(std430, set = 0, binding = 0) buffer IblData { vec4 values[]; } ibl;
void main() {
    uint i = gl_LocalInvocationID.x;
    if (i >= 22) return;
    const vec3 environment = vec3(0.45);
    if (i == 0) {
        ibl.values[i] = vec4(environment, 1.0);
    } else if (i <= 5) {
        float roughness = float(i - 1) / 4.0;
        ibl.values[i] = vec4(environment * (1.0 - 0.32 * roughness), roughness);
    } else {
        uint lutIndex = i - 6;
        float nv = (float(lutIndex % 4) + 0.5) / 4.0;
        float roughness = (float(lutIndex / 4) + 0.5) / 4.0;
        float scale = nv * (1.0 - 0.45 * roughness);
        float bias = (1.0 - nv) * (0.04 + 0.2 * roughness);
        ibl.values[i] = vec4(scale, bias, nv, roughness);
    }
}
